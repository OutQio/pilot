# EditorConfig — https://editorconfig.org
# Keeps formatting consistent across editors / contributors.
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 2

[*.md]
# Markdown often uses trailing whitespace for line breaks
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
